# Copy to .env and fill in. Never commit .env.
# Week 1 needs nothing here: Edge-TTS is free and YouTube auth uses secrets/client_secret.json.
#
# WARNING: do NOT add ANTHROPIC_API_KEY here if you run Claude Code on a Pro/Max subscription.
# When that variable is set, Claude Code bills the API per token instead of your subscription.
# Full key setup + costs: reports/DesiQuip API keys and costs.docx

# --- Week 2: production voice + AI video ---
ELEVENLABS_API_KEY=
VOICE_ID_UNCLE_JI=
FAL_KEY=
HEDRA_API_KEY=

# --- Week 3: research + approval ---
YT_API_KEY=
TG_BOT_TOKEN=
TG_CHAT_ID=

